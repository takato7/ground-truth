# Copy to .env for local docker-compose use. Never commit the real .env.

# Required. SQLite file on the compose volume `db-data` (mounted at /data).
DATABASE_URL=sqlite:////data/ground-truth.db
# Required. Host ports. Avoid 8000, 3000 and 5173, which other local projects use.
BACKEND_PORT=8041
FRONTEND_PORT=5181